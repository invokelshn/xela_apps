<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="uSPa44_n_2modules">
  <xacro:arg name="use_ros2_control" default="false" />
  <xacro:arg name="mount_type" default="standalone" />
  <xacro:property name="use_ros2_control" value="$(arg use_ros2_control)" />
  <xacro:property name="mount_type" value="$(arg mount_type)" />

  <!-- standalone: both modules face the same direction (side by side)  -->
  <!-- gripper:    module 01/02 rotated to face each other               -->

  <!-- 2026-07-10: uSPa44_n variant — uses uSPa44_n.xacro/uSPa44_n.stl, the lighter mesh
       already used (unmodified) by the real robot's URDF (dofbot_rrl.urdf.xacro), instead
       of the older uSPa44.xacro/uSPa44.stl used by xela_uSPa44_2_modules.xacro. Its taxel
       array offsets are symmetric (xoff=yoff, txstep=tystep) and its mesh bounding box is
       already close to centered on the taxel array, so no mesh_rz (separate mesh-only
       rotation) workaround is included here — start with rz only and add mesh_rz later
       (porting the same bbox-pivot mechanism from uSPa44.xacro) only if the mesh visibly
       drifts off the array once rotated. rz/x/y below are a fresh starting point (rz=0,
       untuned) — do NOT reuse the uSPa44 (non-_n) tuned values, this mesh's bounding box
       and taxel offsets are different. -->

  <xacro:include filename="$(find xela_models)/urdf/materials.xacro" />
  <xacro:include filename="$(find xela_models)/urdf/taxel_n.xacro" />
  <xacro:include filename="$(find xela_models)/urdf/uSPa44_n.xacro" />

  <link name="world" />

  <joint name="fixed" type="fixed">
    <parent link="world" />
    <child link="x_taxel_viz" />
  </joint>

  <link name="x_taxel_viz">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>

  <!-- Module 01 (LEFT): 2026-07-10 — whole module (base mesh + taxel array together, via
       the joint's rz) rotated 90deg clockwise for XelaModel display. Rotating the whole
       joint keeps mesh and taxel array aligned with each other (unlike mesh_rz, which only
       rotates the visual mesh). Rotating about the link's own origin (0,0) swings the whole
       footprint away though (confirmed visually) — x/y below re-centers it on the taxel
       array's own local center (~0.0113,0.0113) so it lands back where it started. -->
  <xacro:if value="${mount_type == 'gripper'}">
    <xacro:uSPa44 sequence="x_taxel_01" col="green" parent="x_taxel_viz" taxels="1" x="0" y="0.0226" rz="-90" />
  </xacro:if>
  <xacro:unless value="${mount_type == 'gripper'}">
    <xacro:uSPa44 sequence="x_taxel_01" col="green" parent="x_taxel_viz" taxels="1" x="0" y="0" />
  </xacro:unless>

  <!-- Module 02 (RIGHT): 2026-07-10 — rotated 90deg CCW, and x/y recomputed (same pivot
       method as LEFT) so its footprint center lands on the same Y as LEFT's (horizontal
       alignment) with a ~35mm center-to-center gap. -->
  <xacro:if value="${mount_type == 'gripper'}">
    <xacro:uSPa44 sequence="x_taxel_02" col="red" parent="x_taxel_viz" taxels="1" x="0.0576" y="0" rz="90" />
  </xacro:if>
  <xacro:unless value="${mount_type == 'gripper'}">
    <xacro:uSPa44 sequence="x_taxel_02" col="red" parent="x_taxel_viz" taxels="1" x="0.035" y="0" />
  </xacro:unless>

  <xacro:if value="${use_ros2_control}">
    <ros2_control name="xela_taxel_fake_system" type="system">
      <hardware>
        <plugin>fake_components/GenericSystem</plugin>
      </hardware>
      <joint name="x_taxel_01_uSPa44_01_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa44_02_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa44_03_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa44_04_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa44_05_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa44_06_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa44_07_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa44_08_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa44_09_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa44_10_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa44_11_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa44_12_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa44_13_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa44_14_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa44_15_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa44_16_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa44_01_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa44_02_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa44_03_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa44_04_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa44_05_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa44_06_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa44_07_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa44_08_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa44_09_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa44_10_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa44_11_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa44_12_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa44_13_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa44_14_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa44_15_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa44_16_joint"><command_interface name="position"/><state_interface name="position"/></joint>
    </ros2_control>
  </xacro:if>

</robot>
