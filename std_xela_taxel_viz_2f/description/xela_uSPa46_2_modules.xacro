<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="uSPa46_2modules">
  <xacro:arg name="use_ros2_control" default="false" />
  <xacro:arg name="mount_type" default="standalone" />
  <xacro:property name="use_ros2_control" value="$(arg use_ros2_control)" />
  <xacro:property name="mount_type" value="$(arg mount_type)" />

  <!-- standalone: both modules face the same direction (side by side)  -->
  <!-- gripper:    module 01 rotated 180deg to face module 02            -->

  <xacro:include filename="$(find xela_models)/urdf/materials.xacro" />
  <xacro:include filename="$(find xela_models)/urdf/taxel_n.xacro" />
  <xacro:include filename="$(find xela_models)/urdf/uSPa46.xacro" />

  <link name="world" />

  <joint name="fixed" type="fixed">
    <parent link="world" />
    <child link="x_taxel_viz" />
  </joint>

  <link name="x_taxel_viz">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>

  <!-- Module 01: rotated 180deg in gripper mode to face module 02 -->
  <!-- gripper: y_offset = 0.031 (mesh Y range in link frame: 0 ~ 0.031m) -->
  <!-- uSPa46 visual origin has xyz="0.026 0.0155 0", rpy="3.14 0 3.14", scale=0.001 -->
  <!-- STL Y: -15.5~15.5mm → after transform: 0~31mm = 0~0.031m in link frame -->
  <!-- After rz=180: Y [-0.031, 0] → with y_offset=0.031: Y [0, 0.031] aligned with module 02 -->
  <xacro:if value="${mount_type == 'gripper'}">
    <xacro:uSPa46 sequence="x_taxel_01" col="green" parent="x_taxel_viz" taxels="1" x="0" y="0.031" rz="180" />
  </xacro:if>
  <xacro:unless value="${mount_type == 'gripper'}">
    <xacro:uSPa46 sequence="x_taxel_01" col="green" parent="x_taxel_viz" taxels="1" x="0" y="0" />
  </xacro:unless>

  <!-- Module 02: spacing 65mm (standalone) or 50mm (gripper) -->
  <xacro:if value="${mount_type == 'gripper'}">
    <xacro:uSPa46 sequence="x_taxel_02" col="red" parent="x_taxel_viz" taxels="1" x="0.05" y="0" />
  </xacro:if>
  <xacro:unless value="${mount_type == 'gripper'}">
    <xacro:uSPa46 sequence="x_taxel_02" col="red" parent="x_taxel_viz" taxels="1" x="0.065" y="0" />
  </xacro:unless>

  <xacro:if value="${use_ros2_control}">
    <ros2_control name="xela_taxel_fake_system" type="system">
      <hardware>
        <plugin>fake_components/GenericSystem</plugin>
      </hardware>
      <joint name="x_taxel_01_uSPa46_01_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa46_02_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa46_03_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa46_04_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa46_05_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa46_06_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa46_07_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa46_08_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa46_09_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa46_10_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa46_11_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa46_12_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa46_13_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa46_14_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa46_15_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa46_16_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa46_17_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa46_18_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa46_19_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa46_20_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa46_21_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa46_22_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa46_23_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_01_uSPa46_24_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa46_01_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa46_02_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa46_03_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa46_04_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa46_05_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa46_06_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa46_07_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa46_08_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa46_09_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa46_10_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa46_11_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa46_12_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa46_13_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa46_14_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa46_15_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa46_16_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa46_17_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa46_18_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa46_19_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa46_20_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa46_21_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa46_22_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa46_23_joint"><command_interface name="position"/><state_interface name="position"/></joint>
      <joint name="x_taxel_02_uSPa46_24_joint"><command_interface name="position"/><state_interface name="position"/></joint>
    </ros2_control>
  </xacro:if>

</robot>
